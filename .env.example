# Required in production. Any long random string: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Railway: add a PostgreSQL service and reference its URL here. Without it the app uses a local SQLite file
# that is erased on every deploy.
DATABASE_URL=
# Set to false after you have created your own account, to stop strangers registering.
ALLOW_SIGNUP=true
MAX_UPLOAD_MB=15
